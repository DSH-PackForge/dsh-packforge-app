{
  "name": "@dsh-packforge/plugin",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH 客户端插件：在 DSH Web GUI 内导出/导入/市场浏览/查看整合包（core + host-dsh-plugin）",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "dspack",
    "整合包",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"test/*.test.js\"",
    "bundle": "esbuild src/client.js --bundle --format=iife --platform=browser --target=es2020 --external:react --external:react/jsx-runtime --external:@deepseek-ai/* --outfile=lib/client.js"
  },
  "dependencies": {
    "@dsh-packforge/core": "workspace:*",
    "@dsh-packforge/host-dsh-plugin": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.2.0"
  }
}